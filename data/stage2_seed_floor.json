 "HEADLINE_single_run_G2_differences_below_this_are_noise": {
  "control_sd_over_5_seeds": 0.0564,
  "unpaired_MDE_two_single_runs": 0.1841,
  "reading": "Two independent single runs of the untreated config must differ by more than 0.1841 on G2 sport_acc before the difference is distinguishable from a seed swap. The control's own range across 5 seeds is 0.6614 to 0.7782.",
  "pairing_is_cheaper_but_MEASURE_how_much": {
   "paired_MDE": 0.0677,
   "unpaired_MDE": 0.1841,
   "pairing_gain": "2.7x",
   "sd_of_control": 0.0564,
   "sd_of_differences": 0.0545,
   "why_the_gain_is_small_here": "Pairing cancels variance the two arms SHARE. The treated arm is clamped to the majority-class floor, so it shares almost none of the control's spread: sd of differences 0.0545 vs sd of control 0.0564. In the limit of a perfect clamp, diff = constant - control and Var(diff) = Var(control), so pairing cancels nothing and only df changes. Pairing still wins; the multiplier is measured rather than carried over from another experiment."
  }
 }
